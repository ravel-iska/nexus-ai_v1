# ══════════════════════════════════════════════════════
# WA AGENT NEXUS v3.0 — ENVIRONMENT VARIABLES
# ══════════════════════════════════════════════════════

# ─── APP ───
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
APP_PORT=8000

# ─── DATABASE ───
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_db
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me

MONGODB_URI=mongodb://localhost:27017/nexus
REDIS_URL=redis://localhost:6379/0

# ─── AI / LLM ───
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nexus3:latest
OPENROUTER_API_KEY=sk-or-xxxx
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4

# ─── WHATSAPP ───
WA_SESSION_NAME=nexus-main
WA_ADMIN_NUMBER=6281234567890
WA_AUTO_READ=true

# ─── NOTIFICATIONS ───
GMAIL_CLIENT_ID=xxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxx
GMAIL_REFRESH_TOKEN=xxxx
ADMIN_EMAIL=admin@example.com

TELEGRAM_BOT_TOKEN=xxxx
TELEGRAM_CHAT_ID=xxxx

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxx

# ─── SENTRY / ERROR TRACKING ───
SENTRY_DSN=https://xxxx@sentry.io/xxxx
SENTRY_ENVIRONMENT=development

# ─── BLOCKCHAIN ───
ALCHEMY_API_KEY=xxxx
MORALIS_API_KEY=xxxx
ETHERSCAN_API_KEY=xxxx
COINGECKO_API_KEY=xxxx

# ─── OSINT / SECURITY ───
SHODAN_API_KEY=xxxx
HIBP_API_KEY=xxxx
VIRUSTOTAL_API_KEY=xxxx

# ─── VOICE ───
WHISPER_MODEL=base
TTS_ENGINE=gtts

# ─── NEO4J (Knowledge Graph) ───
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# ─── CHROMADB (Vector Store) ───
CHROMA_PERSIST_DIR=./data/chroma

# ─── PROXY ───
PROXY_POOL_URL=http://proxy-pool:5555
PROXY_ROTATION=true
